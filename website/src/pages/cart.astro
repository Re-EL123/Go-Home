---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

const pageTitle = `Cart | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription="Review your Re-EL graphic design cart and request a quote via WhatsApp."
  customOgTitle="Your Cart - Re-EL"
>
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 md:text-4xl">Your Design Cart</h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">
        Review selected graphic design items and send a quote request on WhatsApp. Prices in ZAR, excl. VAT.
      </p>
    </div>
    <div id="cart-root" class="mx-auto mt-10 max-w-4xl rounded-2xl border border-neutral-200 bg-white p-6 dark:border-neutral-700 dark:bg-neutral-900"></div>
  </section>

  <script is:inline src={`${import.meta.env.BASE_URL}js/store.js`}></script>
  <script is:inline>
    (function () {
      function fmt(n) { return 'R' + Number(n).toLocaleString('en-ZA'); }
      function render() {
        var root = document.getElementById('cart-root');
        if (!root || !window.ReELCart) return;
        var items = window.ReELCart.items();
        if (!items.length) {
          root.innerHTML =
            '<div class="py-12 text-center">' +
            '<h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">Your cart is empty</h2>' +
            '<p class="mt-2 text-neutral-600 dark:text-neutral-400">Add graphic design items from the Services page to get a quote.</p>' +
            '<a href="' + (document.querySelector('base')?.href || '/') + 'services" class="mt-6 inline-flex rounded-lg bg-yellow-400 px-5 py-3 font-semibold text-neutral-800">Browse Services</a>' +
            '</div>';
          return;
        }
        var rows = items.map(function (it) {
          var line = it.price * it.qty;
          return '<tr class="border-b border-neutral-200 dark:border-neutral-700">' +
            '<td class="py-3 pr-4">' + it.name + '</td>' +
            '<td class="py-3 pr-4">' + fmt(it.price) + '</td>' +
            '<td class="py-3 pr-4"><span class="inline-flex items-center gap-2">' +
              '<button type="button" onclick="ReELCart.changeQty(\'' + it.id + '\',-1)" class="rounded bg-neutral-200 px-2 dark:bg-neutral-700">−</button>' +
              '<span>' + it.qty + '</span>' +
              '<button type="button" onclick="ReELCart.changeQty(\'' + it.id + '\',1)" class="rounded bg-neutral-200 px-2 dark:bg-neutral-700">+</button>' +
            '</span></td>' +
            '<td class="py-3 pr-4">' + fmt(line) + '</td>' +
            '<td class="py-3"><button type="button" onclick="ReELCart.remove(\'' + it.id + '\')" class="text-red-600">Remove</button></td>' +
            '</tr>';
        }).join('');
        var total = window.ReELCart.total();
        root.innerHTML =
          '<div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead><tr class="border-b border-neutral-200 dark:border-neutral-700">' +
          '<th class="pb-3">Item</th><th class="pb-3">Unit</th><th class="pb-3">Qty</th><th class="pb-3">Line</th><th></th></tr></thead><tbody>' + rows + '</tbody></table></div>' +
          '<div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-200 pt-6 dark:border-neutral-700">' +
            '<div class="text-lg font-bold">Total: ' + fmt(total) + ' <span class="text-sm font-normal text-neutral-500">excl. VAT</span></div>' +
            '<div class="flex flex-wrap gap-3">' +
              '<a href="services" class="rounded-lg border border-neutral-300 px-4 py-2 font-medium dark:border-neutral-600">Add More</a>' +
              '<button type="button" id="checkout-wa" class="rounded-lg bg-yellow-400 px-5 py-2 font-semibold text-neutral-800">Request via WhatsApp</button>' +
            '</div>' +
          '</div>';
        document.getElementById('checkout-wa')?.addEventListener('click', function () {
          var lines = items.map(function (i) { return '• ' + i.name + ' x' + i.qty + ' — ' + fmt(i.price * i.qty); });
          var msg = 'Hi Re-EL! I would like a quote for:%0A%0A' + lines.join('%0A') + '%0A%0ATotal: ' + fmt(total) + ' (excl. VAT)';
          window.open('https://wa.me/27813864024?text=' + msg, '_blank');
        });
      }
      window.ReELCartRender = render;
      document.addEventListener('DOMContentLoaded', render);
      render();
    })();
  </script>
</MainLayout>
